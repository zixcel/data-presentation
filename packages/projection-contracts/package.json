{
  "name": "@zixcel/projection-contracts",
  "version": "0.10.4",
  "description": "Renderer-independent bounded projection, lineage and Scene contracts",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "contract.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-PREVIOUS",
    "README.ja.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./client": {
      "types": "./src/client.d.mts",
      "import": "./src/client.mjs"
    }
  },
  "imports": {
    "#hash": {
      "browser": "./src/hash-browser.mjs",
      "default": "./src/hash-node.mjs"
    }
  },
  "dependencies": {
    "ohash": "2.0.12",
    "@zixcel/interaction": "0.10.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/public-types.mts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-projection-contracts.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/data-presentation.git",
    "directory": "packages/projection-contracts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "types": "./src/index.d.mts",
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.12.0"
  },
  "packageManager": "pnpm@10.29.3",
  "keywords": [
    "typed-contracts",
    "schema-validation",
    "data-presentation",
    "javascript"
  ]
}
