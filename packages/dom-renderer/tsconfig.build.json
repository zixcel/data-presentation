{
  "compilerOptions": {
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "types": ["node"],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "implementation",
    "outDir": "src",
    "newLine": "lf",
    "declarationDir": "build/types"
  },
  "include": [
    "implementation/**/*.mts"
  ]
}
