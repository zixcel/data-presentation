{
  "name": "@zixcel/dom-renderer",
  "version": "0.10.5",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Trusted native DOM rendering of PP RenderPlans and Zixcel owner inputs",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-PREVIOUS",
    "README.ja.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./style": "./src/style.css"
  },
  "dependencies": {
    "three": "0.186.1",
    "@zixcel/interaction": "0.10.1",
    "@zixcel/projection-client": "0.10.4"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mts",
    "test:browser": "node test/world-browser.mts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/emit-dom-declarations.mts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/data-presentation.git",
    "directory": "packages/dom-renderer"
  },
  "types": "./src/index.d.mts",
  "keywords": [
    "dom",
    "data-presentation",
    "rendering",
    "typescript"
  ]
}
