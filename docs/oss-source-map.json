        "bin": {},
        "main": null,
        "types": "./src/index.d.mts"
      },
      "declared_commands": {
        "test": "node --test test/*.test.mjs"
      }
    },
    {
      "manifest": "packages/view-server/package.json",
      "package": "@zixcel/view-delivery",
      "ecosystem": "npm",
      "description": "Bounded trusted document and asset delivery; existing Crowsi STATE transport only",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./src/index.d.mts",
