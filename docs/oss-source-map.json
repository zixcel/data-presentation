{
  "repository": "zixcel/data-presentation",
  "purpose": "Generate, update and deliver view projections from explicitly supplied source data.",
  "responsibility_boundary": "Products own source-of-truth storage, authentication and business actions. Projection contracts do not confer execution authority.",
  "packages": [
    {
      "manifest": "package.json",
      "package": "@zixcel/projection-runtime",
      "ecosystem": "npm",
      "description": "Bounded read-only producer execution and disposable durable projection publication",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./src/runtime.d.mts",
            "import": "./src/runtime.mjs"
          },
          "./store": {
            "types": "./src/store.d.mts",
            "import": "./src/store.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": "./src/runtime.d.mts"
      },
      "declared_commands": {
        "test": "node --test --test-concurrency=1 test/*.test.mjs test/*.test.mts",
        "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/public-types.mts",
        "playground:build": "node scripts/build-playground.mjs",
        "playground:serve": "node scripts/serve-playground.mjs",
        "playground:test": "node test/playground-browser.mjs",
        "test:consumer": "node scripts/verify-packed-consumer.mts"
      }
    },
    {
      "manifest": "packages/dom-renderer/package.json",
