      "interfaces": {
        "exports": {
          ".": {
            "types": "./src/index.d.mts",
            "import": "./src/index.mjs"
          },
          "./style": "./src/style.css"
        },
        "bin": {},
        "main": null,
        "types": "./src/index.d.mts"
      },
      "declared_commands": {
        "test": "node --test test/*.test.mjs",
        "test:browser": "node test/world-browser.mjs"
      }
    },
    {
      "manifest": "packages/projection-client/package.json",
