{
  "name": "@zixcel/projection-runtime",
  "version": "0.10.3",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Bounded read-only producer execution and disposable durable projection publication",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-PREVIOUS",
    "README.ja.md",
    "docs/architecture-and-operations.md",
    "docs/architecture-and-operations.ja.md"
  ],
  "exports": {
    ".": {
      "types": "./src/runtime.d.mts",
      "import": "./src/runtime.mjs"
    },
    "./store": {
      "types": "./src/store.d.mts",
      "import": "./src/store.mjs"
    }
  },
  "dependencies": {
    "@zixcel/projection-contracts": "0.10.3"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/public-types.mts",
    "playground:build": "node scripts/build-playground.mjs",
    "playground:serve": "node scripts/serve-playground.mjs",
    "playground:test": "node test/playground-browser.mjs",
    "test:consumer": "node scripts/verify-packed-consumer.mts",
    "check:typescript": "pnpm -r --include-workspace-root --if-present run build && tsc -p tsconfig.tooling.json && node --test test/typescript-migration.test.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/data-presentation.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "types": "./src/runtime.d.mts",
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.12.0",
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.1",
    "@zixcel/projection-client": "0.10.3",
    "@zixcel/dom-renderer": "0.10.3",
    "@crowsi/browser-security": "0.10.0"
  },
  "packageManager": "pnpm@10.29.3",
  "keywords": [
    "data-visualization",
    "projections",
    "state-management",
    "typescript",
    "web-components"
  ]
}
