{
  "name": "@zixcel/projection-runtime",
  "version": "0.10.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Bounded read-only producer execution and disposable durable projection publication",
  "engines": {
    "node": ">=22"
  },
  "files": [
